layout local
  debug off
  # map-header 0 0 off
  # symbol-hide group cave-centreline
endlayout

source "Tratmans.th"

export model -fmt survex -o "Tratmans-th.3d"

export map -proj plan -layout local -o "Tratmans-plan.pdf"

export map -proj extended -layout local -o "Tratmans-ee.pdf"
