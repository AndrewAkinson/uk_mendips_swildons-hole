encoding  utf-8
#Swildons Hole, Priddy, Mendip, Somerset, UK
#Resurvey Project. Lead by Paul 'Footleg' Fretwell, Jun. 2013 - Mar. 2017
#Elevation Maps for Entrance Series

# (input statements for drawings are in the corresponding centreline data .th files)

 join ShortDryWaySE1@ShortDryWay.Swildons ShortDryWaySE2@ShortDryWay.Swildons

map EntranceSeriesElevEW -projection [elevation 000] -title "Swildons Hole - Entrance Series Elevation"
# elevfixSP@Swildons
  OldGrottoSE1@LongDryWay.Swildons
  ShortDryWaySE1@ShortDryWay.Swildons
  ShortDryWaySE2@ShortDryWay.Swildons
endmap

map EntranceSeriesElevEWCentreline -projection [elevation 000] -title "Swildons Hole - Entrance Series Elevation"
  Swildons
endmap
