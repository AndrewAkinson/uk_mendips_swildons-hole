encoding  utf-8
# The Entrance Series plan (1:200) draws the entrance passages and Zig Zags
# displaced to the east, clear of the passages beneath them (see
# Swildons_MAP_EntranceSeries.th). These two scraps carry the letters that
# match where that upper level joins the passages below, and a note on each
# level. Coordinates are metres; the station points place them exactly.

scrap EntranceLevelTop -projection plan -scale [0 0 1 1 0 0 1 1 m]

point 7.01 21.03 label -text "<bf>A" -scale xl
point 9.27 16.77 label -text "<bf>A" -scale xl
point 17.46 9.63 label -text "<bf>B" -scale xl
point 23.5 30.5 label -text "<it>Upper level: the entrances and Zig Zags,<br>drawn 35 m east of where they are.<br>It joins the passages below at A and B." -scale m -align r

point 8.31 21.63 station -name 1.20@ZigZags
point 10.67 17.97 station -name 2.3@LongDryWay
point 16.46 11.23 station -name 1.5@ZigZags
point 15.25 24.65 station -name 1.16@ZigZags

endscrap

scrap EntranceLevelLower -projection plan -scale [0 0 1 1 0 0 1 1 m]

point 7.95 20.70 label -text "<bf>A" -scale xl
point 13.80 7.89 label -text "<bf>B" -scale xl
point 29.56 18.63 label -text "<it>The upper level (the entrances and Zig Zags)<br>is drawn 35 m east: join it at A and B." -scale m -align r

point 9.55 20.50 station -name 2.4@LongDryWay
point 15.00 9.29 station -name 20.2@ShowerbathArea
point 8.68 23.19 station -name 1.21@ZigZags

endscrap
