encoding  utf-8
#Swildons Hole, Priddy, Mendip, Somerset, UK
#Extended elevation of the streamway from the Old 40 to Sump 1

# (input statements for drawings are in the corresponding centreline data .th files)

map StreamwayElevation -projection extended -title "Swildons Hole - Streamway, Old 40 to Sump 1"
  Old40to20SE1@Old40To20.Swildons
  20ftToBarnesLoopSE1@20ftToBarnesLoop.Swildons
  DblPotsDownstreamSE1@DblPotsDownstream.Swildons
  BarnesLoopToTratmansSE2@BarnesLoopToTratmans.Swildons
  BarnesLoopToTratmansSE1@BarnesLoopToTratmans.Swildons
  TratmansToSump1SE1@TratmansToSump1.Swildons
endmap
