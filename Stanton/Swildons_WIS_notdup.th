encoding  utf-8
survey wstanton
#Swildons Hole, Priddy, Mendip, Somerset, UK
#Survey centreline data from Willie Stanton notebooks. 
#Therion project created by Paul 'Footleg' Fretwell, June 2012 - Mar 2017

#Data which is covered by the 2012 and later resurvey is commented out in this file.

  centerline
    cs OSGB:ST 
    # This centreline only joins Stanton's books together (equates, no shots),
    # so this date affects nothing: it isn't inherited by the surveys input
    # below. Each of those has its own 1950s date, and Therion corrects their
    # compass bearings with the magnetic declination for that date (about -10
    # degrees then, -2 now; see "geomag declinations" in the build log).
    date 2013.06.09

#    station Ent "Swildons Hole" entrance
#    fix Ent 53121 51298 235  #Lat:51.25890870001207, Lon: -2.673194110393524 (picked off Googlemaps)

#    equate  Ent  EC@swil1a
#    equate  DH@swil1a  DH@swil1b
#    equate  CN@swil1b  CN@swil1c
    equate  AY@swil1c  AY@swil1d
    equate  AL@swil1d  AL@swil1e
    equate  AL@swil1d  AL@swil1f
    equate  o@swil1f  o@swil1g
#    equate  DO@swil1a  DO@swil1h
#    equate  DA@swil1b  DA@swil1h
#    equate  FB@swil1h  FB@swil1i
#    equate  CS@swil1b  CS@swil1i
    equate  ag@swil1g  ag@swil1j
    equate  124@swil1j  124@swil1k
    equate  143@swil1j  143@swil1k
    equate  113@swil1j  113@swil1l
    equate  113@swil1l  113@swil1m
    equate  215@swil1l  215@swil1m
    equate  220@swil1l  220@swil1m
    equate  204@swil1k  204@swil1n
    equate  262@swil1n  262@swil1o
  
    equate  A@swil2a  A@swil2b
    equate  C1@swil2a  C1@swil2b
    equate  M@swil2a  M@swil2b
    equate  T@swil2a  T@swil2b
    equate  U@swil2a  U@swil2b
    equate  e2@swil2b  e2@swil2c
    equate  C1@swil2a  C1@swil2b
    equate  B1@swil2a  B1@swil1e
    equate  18@swil2b  18@swil2c
    equate  D@swil2a  D@swil2c
    equate  46@swil2c  46@swil2d
    equate  273@swil1o  273@swil2e

  endcentreline

#  input swildons1-a.th
#  input swildons1-b.th
  input 1953-02-08/swildons1-c.th
