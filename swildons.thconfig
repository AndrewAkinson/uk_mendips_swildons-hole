encoding  utf-8
# =====================================================================
#  Swildons Hole -- the CI build
# =====================================================================
#
#  This is the file the GitHub Actions workflow runs. It builds the
#  whole cave: the master plan, the Entrance Series elevation, the 3D
#  models and the data exports, all into output/.
#
#  The Entrance Series plan at 1:200 is a second sheet of the same
#  projection at a different scale, and Therion only takes one selected
#  map per projection per run, so it has its own config next to this
#  one: swildons-entrance.thconfig. CI runs both.
#
#  The older configs from the SVN project (swildons_*.thconfig and
#  swildons_model.thconfig) still work and still write into the project root
#  as they always did. This one does not replace them, it just gathers
#  their exports in one place for the website.
#
#  Build locally with:   therion -l output/therion.log swildons.thconfig && therion swildons-entrance.thconfig
#  (see README.md for the Docker one-liner and the OS grid file).
# ---------------------------------------------------------------------

input gb_layout.thc

source swildonsmaster.th
source altitude-colours.th

# One map per projection. The plan is everything drawn so far; the
# projected elevation is the drawn Entrance Series, and the extended
# elevation is the streamway from the Old 40 to Sump 1.
select MasterPlan@SwildonsHole
select EntranceSeriesElevEW@SwildonsHole
select StreamwayElevation@SwildonsHole


# ---------------------------------------------------------------------
#  Layouts -- the same settings as swildons_all.thconfig, colour by
#  altitude on top of Footleg's British symbol set (gb_layout.thc).
# ---------------------------------------------------------------------

# The map header with the altitude legend in its own column beside the
# title, scale bar and survey details, instead of stacked under them, and
# the symbol legend full width underneath. This is Therion's own
# \legendcontent (therion.tex) with the colour legend moved into an \hbox.
layout header-two-columns
  code tex-map
    \newbox\hdrtextbox \newbox\hdrcolourbox
    \newdimen\hdrcolourwidth \hdrcolourwidth=4.5cm
    \newdimen\hdrgap \hdrgap=0.8cm
    \newdimen\hdrtextwidth
    \def\hdrnortharrow{%
      \ifnortharrow
        \setbox\tmpboxa=\hbox{\northarrow}%
        \tmpdimen=\dimexpr(\wd\tmpboxa+10pt)%
        \vbox to 0pt{\line{\hfil\box\tmpboxa}\vss}%
      \fi}
    \def\hdrtextcolumn{%
      \setbox\hdrtextbox=\vtop{\hsize=\hdrtextwidth
        \edef\tmp{\the\cavename}\ifx\tmp\empty\else
          {\rightskip=\tmpdimen plus 10em\the\legendtextheadersize\the\cavename\par}\vskip1cm
        \fi
        \ifscalebar\scalebar\vskip1cm\fi
        {\rightskip=0pt plus 3em\parskip=3bp
          \edef\tmp{\the\comment}\ifx\tmp\empty\else{\the\legendtextsize\the\comment\par}\medskip\fi
          \everypar{\hangindent=2em\hangafter=1}%
          \edef\tmp{\the\cavelength}\ifx\tmp\empty\else{\the\legendtextsize\si\the\cavelengthtitle: \ss\the\cavelength\par}\fi
          \edef\tmp{\the\cavedepth}\ifx\tmp\empty\else{\the\legendtextsize\si\the\cavedepthtitle: \ss\the\cavedepth\par}\fi
          \edef\tmp{\the\exploteam}\ifx\tmp\empty\else{\the\legendtextsize\si\the\explotitle: \ss\the\exploteam\quad\si\the\explodate\par}\fi
          \edef\tmp{\the\topoteam}\ifx\tmp\empty\else{\the\legendtextsize\si\the\topotitle: \ss\the\topoteam\quad\si\the\topodate\par}\fi
          \edef\tmp{\the\cartoteam}\ifx\tmp\empty\else{\the\legendtextsize\si\the\cartotitle: \ss\the\cartoteam\quad\si\the\cartodate\par}\fi
          \edef\tmp{\the\copyrights}\ifx\tmp\empty\else{\the\legendtextsize\ss\the\copyrights\par}\fi
        }}}
    \def\hdrcolourcolumn{%
      \setbox\hdrcolourbox=\vtop{\hsize=\hdrcolourwidth
        \ifcolorlegend
          \vskip1.2cm{\the\legendtextsectionsize\the\colorlegendtitle}\bigskip
          \insertcolorlegend
        \fi}}
    \legendcontent={%
      \hsize=\legendwidth
      \black\the\legendtextcolor
      \hdrnortharrow
      \hdrtextwidth=\dimexpr\legendwidth-\hdrcolourwidth-\hdrgap\relax
      \hdrtextcolumn \hdrcolourcolumn
      \hbox{\box\hdrtextbox\hskip\hdrgap\box\hdrcolourbox}%
      \iflegend
        \vskip1cm{\the\legendtextsectionsize\the\legendtitle}\bigskip
        \insertlegend
      \fi
      \black
    }
  endcode
endlayout

# The plan's header in one row, set in Source Sans 3 (therion.ini):
# the cave name large, a grey subtitle, length and depth, a slim scale
# bar and the credits; then the altitude legend; then the symbol legend
# shrunk to \hdrlegendscale, pushed down \kern1.6cm to clear the cave
# above it. The north arrow sits beside the title. legend-width is the
# width of the title column.
layout header-plan
  code tex-map
    \newbox\hdrtextbox \newbox\hdrcolourbox \newbox\hdrlegendbox
    \newdimen\hdrgap \hdrgap=1.4cm
    \newdimen\hdrlegendwidth \hdrlegendwidth=22cm
    \def\hdrlegendscale{0.75}
    \def\grey{\pdfliteral{0.40 g 0.40 G}}
    \def\sep{\hskip0.7em{\pdfliteral{0.70 g}\vrule width 0.8pt height 10pt depth 1pt\grey}\hskip0.7em}
    \def\credit#1#2#3{%
      \edef\tmp{\the#2}\ifx\tmp\empty\else
        \noindent{\setsize[9]\grey\bf\the#1\black}\par\nobreak\vskip1pt
        {\setsize[12]\rm\the#2\edef\tmp{\the#3}\ifx\tmp\empty\else
          \hskip0.6em{\grey\it\the#3}\black\fi\par}\vskip7pt
      \fi}
    \legendcontent={%
      \hsize=\legendwidth
      \black
      \setbox\hdrtextbox=\vtop{\hsize=\legendwidth
        \rightskip=0pt plus 4em \parindent=0pt \baselineskip=1.25em
        \ifnortharrow\vbox to 0pt{\line{\hfil\northarrow\kern1cm}\vss}\fi
        {\setsize[46]\bf\the\cavename\par}\vskip6pt
        {\setsize[15]\grey Priddy, Mendip Hills\sep Plan\sep 1\thinspace:\thinspace500\black\par}
        \vskip16pt
        {\setsize[13]\rm
          \edef\tmp{\the\cavelength}\ifx\tmp\empty\else{\bf\the\cavelength} long\fi
          \edef\tmp{\the\cavedepth}\ifx\tmp\empty\else\quad\quad{\bf\the\cavedepth} deep\fi\par}
        \vskip18pt
        \ifscalebar\hbox{\kern-2pt\scalebar}\vskip20pt\fi
        \credit\topotitle\topoteam\topodate
        \credit\cartotitle\cartoteam\cartodate
        \vskip4pt
        {\setsize[9]\grey
          \edef\tmp{\the\copyrights}\ifx\tmp\empty\else\the\copyrights\par\fi
          \edef\tmp{\the\comment}\ifx\tmp\empty\else\the\comment\par\fi\black}
      }%
      \setbox\hdrcolourbox=\vtop{\hsize=3.6cm
        \ifcolorlegend
          {\setsize[9]\grey\bf\the\colorlegendtitle\black}\vskip10pt
          \insertcolorlegend
        \fi}%
      \iflegend
        \setbox\hdrlegendbox=\vbox{\hsize=\hdrlegendwidth
          {\setsize[11]\grey\bf\the\legendtitle\black}\vskip12pt
          \insertlegend}%
        \setbox\tmpboxb=\hbox{\pdfsave\pdfsetmatrix{\hdrlegendscale\space 0 0 \hdrlegendscale}%
          \rlap{\lower\ht\hdrlegendbox\box\hdrlegendbox}\pdfrestore}%
        \tmpdimen=\dp\tmpboxb \tmpdimen=\hdrlegendscale\tmpdimen
        \ht\tmpboxb=0pt \dp\tmpboxb=0pt
        \setbox\hdrlegendbox=\vtop{\kern1.6cm
          \box\tmpboxb\kern\tmpdimen}%
        \wd\hdrlegendbox=\hdrlegendscale\hdrlegendwidth
      \fi
      \hbox{\box\hdrtextbox\hskip\hdrgap\box\hdrcolourbox
        \iflegend\hskip\hdrgap\box\hdrlegendbox\fi}%
      \black
    }
  endcode

  # A slim scale bar: thin alternating bar, small figures, no big
  # "Scale = 1 : 500" (the scale is in the subtitle).
  code metapost
    def s_scalebar (expr l, units, txt) =
      begingroup
        interim warningcheck:=0;
        tmpl:=l / Scale * cm * units / 2;
        tmpx:=l / Scale * cm * units / 5;
        tmph:=5bp;
      endgroup;
      pickup pencircle scaled 0.5bp;
      p:=(0,0)--(tmpx,0)--(tmpx,-tmph)--(0,-tmph)--cycle;
      for i:=-2.5 step 1 until 2:
        if (round(i+2.5) mod 2) = 0: fill p shifted (i * tmpx,0) withcolor (0.15,0.15,0.15);
        else: fill p shifted (i * tmpx,0) withcolor (0.82,0.82,0.82); fi;
      endfor;
      begingroup
        interim labeloffset:=4bp;
        for i:=0 step (l/5) until (l-1):
          tmpx:=tmpl * (i * 2 / l - 1);
          label.bot(thTEX("\size[10]" & decimal (i)), (tmpx,-tmph));
        endfor;
        label.bot(thTEX("\size[10]" & decimal (l) & "\thinspace" & txt), (tmpl,-tmph));
      endgroup;
    enddef;
  endcode
endlayout

layout plan-sheet
  copy GB_Std

  scale 1 500
  base-scale 1 350

  symbol-hide line survey
  symbol-hide point station   # survey stations are for surveyors, not for finding the way

  # The cave runs west to Sump 1, leaving room under the middle of the
  # plan: the header starts there, just right of Tratman's Temple, and
  # runs in one row under the Entrance Series, which keeps the sheet thin.
  map-header 31 20 nw
  legend-columns 4
  legend-width 17 cm
  copy header-plan

  # Passage labels a step larger than Therion's 1:500 defaults, so the
  # names stay readable when the sheet is zoomed on a phone.
  fonts-setup 6 8 11 14 20

  color map-fg altitude:warm
  copy LayoutColourSymbols
endlayout

# Same drawing for a black-and-white printer: no altitude tint and no
# colour symbols, passages filled light grey.
layout plan-bw
  copy GB_Std

  scale 1 500
  base-scale 1 350

  symbol-hide line survey
  symbol-hide point station   # survey stations are for surveyors, not for finding the way

  # The cave runs west to Sump 1, leaving room under the middle of the
  # plan: the header starts there, just right of Tratman's Temple, and
  # runs in one row under the Entrance Series, which keeps the sheet thin.
  map-header 31 20 nw
  legend-columns 4
  legend-width 17 cm
  copy header-plan

  # Passage labels a step larger than Therion's 1:500 defaults, so the
  # names stay readable when the sheet is zoomed on a phone.
  fonts-setup 6 8 11 14 20

  color map-fg [85]
endlayout

layout elevation-sheet
  copy GB_Std

  scale 1 200
  base-scale 1 180

  symbol-hide line survey
  symbol-hide point station   # survey stations are for surveyors, not for finding the way

  color map-fg altitude:warm
  copy LayoutColourSymbols
endlayout

# The streamway elevation is long and shallow (about 480 m unrolled,
# 70 m deep), so it uses the plan's 1:500. It falls from left to right,
# so the header goes in the empty space under the upstream end.
layout streamway-elevation
  copy GB_Std

  scale 1 500
  base-scale 1 350

  symbol-hide line survey
  symbol-hide point station   # survey stations are for surveyors, not for finding the way

  map-header 0 72 nw
  legend-columns 5
  legend-width 30 cm
  copy header-two-columns

  color map-fg altitude:warm
  copy LayoutColourSymbols
endlayout


# ---------------------------------------------------------------------
#  Sheets
# ---------------------------------------------------------------------

export map -projection plan            -layout plan-sheet      -o output/Swildons-plan.pdf
export map -projection plan            -layout plan-bw         -o output/Swildons-plan-bw.pdf
export map -projection [elevation 000] -layout elevation-sheet -o output/Swildons-entrance-elevation.pdf
export map -projection extended        -layout streamway-elevation -o output/Swildons-streamway-elevation.pdf

# Vector and GIS versions of the plan.
export map -projection plan -layout plan-sheet -fmt svg -o output/Swildons-plan.svg
export map -projection plan -fmt kml -o output/Swildons-plan.kml
# Shapefiles in OS grid metres, which tools/webmap turns into the
# GeoJSON downloads and the map page. Therion writes each as a
# directory of points, lines, areas and passage outlines.
export map -projection plan -fmt esri -o output/esri-plan


# ---------------------------------------------------------------------
#  Models and data -- the whole centreline, not just the drawn part.
# ---------------------------------------------------------------------

export model -fmt loch   -o output/Swildons.lox
export model -fmt survex -o output/Swildons.3d
export model -fmt kml    -o output/Swildons-centreline.kml
export model -fmt vrml   -o output/Swildons.vrml
# For the 3D view on the website (tools/model3d): walls from the drawings
# only. The default adds walls from every splay shot, which come out as
# spikes wherever a splay reaches up an aven or into a side passage.
export model -fmt loch -wall-source maps -o output/Swildons-walls.lox
# Legs and stations as shapefiles, for tools/webmap.
export model -fmt esri -o output/esri-model

export continuation-list -fmt html -o output/Swildons-continuations.html
export cave-list   -location on -o output/Swildons-caves.html
export survey-list -o output/Swildons-surveys.html

export database -fmt csv -o output/Swildons.csv
export database -fmt sql -o output/Swildons.sql
