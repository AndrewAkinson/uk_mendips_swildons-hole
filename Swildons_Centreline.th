encoding  utf-8
#Swildons Hole, Priddy, Mendip, Somerset, UK
#Centreline survey data

survey Swildons

  #Centreline data from Willie Stanton original survey 
  input Stanton/Swildons_WIS_notdup.th
  
  #Data files which share a .th2 file (imported here too)
  
  input Entrance/EntToWaterChamber/ZigZags.th
  input Entrance/EntToWaterChamber/LongDryWay.th
  input Entrance/EntToWaterChamber/NewGrottoes.th
  input Entrance/EntToWaterChamber/OldGrottoToWaterChamber.th
  input Entrance/EntToWaterChamber/InletOffOldGrottoToWaterChamber.th
  #Combined sketch for all 5 of the above
  input Entrance/EntToWaterChamber/Swil1P_Ent-OldGrotto-WaterChamber.th2
  
  input Entrance/WetWayOxbows/WetWayOxbows.th
  input Entrance/WetWayOxbows/WetWayKeyhole.th
  #Combined sketch for all 2 of the above
  input Entrance/WetWayOxbows/Swil1P_WetWayOxbows.th2
  
  #The following data files import their respective sketches
  #directly inside their sub-survey data blocks.
  input Entrance/ShortDryWay/ShortDryWay.th
  input Entrance/KenneysDigToShowerbath/KenneysDigToShowerbath.th
  input Entrance/ShowerbathArea/ShowerbathArea.th
  input Entrance/Old40Route/Old40Route.th
  input Entrance/WaterRift/WaterRift.th
  input Entrance/ButcombeOxbows/ButcombeOxbows.th
  input Entrance/WaterChamber/WaterChamber.th
  input Entrance/OxbowJunction/OxbowJunction.th
  input Entrance/LowerOxbow/LowerOxbow.th
  input Entrance/CisternDig/CisternDig.th
  input Streamway/Old40To20/Old40To20.th
  input Entrance/RollingThunder/RollingThunder.th
  input Streamway/20ftToBarnesLoop/20ftToBarnesLoop.th
  input Streamway/DblPotsDownstream/DblPotsDownstream.th
  input Streamway/BarnesLoopToTratmans/BarnesLoopToTratmans.th
  input Streamway/TratmansToSump1/TratmansToSump1.th

  #Entrance Series extended elevation and cross-sections, from the PocketTopo sketches
  input Entrance/EntToWaterChamber/Swil1E_ext_EntToWaterChamber.th2

  centreline
    copyright 2019 "Paul 'Footleg' Fretwell"
    
    cs OSGB:ST 
    station Ent "Swildons Hole" entrance
    fix Ent 53122.3 51308.5 237.3 #From surface survey using two GPS fixes nearby under open clear sky. Done by Footleg 30 Jun 2013
  #fix Ent 53126 51303 248 #From GPS WAAS fix over door of blockhouse after tree was cut back. Done by Footleg 09 Jul 2016
  
    fix bottom 53130 51310 140 #Fake station to pin lowest elevation in colour by elevation

    equate Ent 1.3@ZigZags

#    equate 3.2@ShortDryWay DM@swil1a.wstanton
#    equate 6.7@OldGrottoToWaterChamber CX@swil1b.wstanton
    equate 8.16@WaterRift CG@swil1c.wstanton

    equate 1.5@ZigZags 2.0@LongDryWay 
    equate 1.21@ZigZags 2.5@LongDryWay 
    equate 2.5@LongDryWay 3.0@ShortDryWay 
    equate 2.59@LongDryWay 4.3@ShortDryWay 
    equate 2.39@LongDryWay 5.0@NewGrottoes 
    equate 2.59@LongDryWay 6.0@OldGrottoToWaterChamber 
    equate 2.62@LongDryWay 6.4@OldGrottoToWaterChamber 
    equate 2.8@LongDryWay 10.0@KenneysDigToShowerbath 
    equate 2.0@LongDryWay 20.0@ShowerbathArea 
    equate 10.18@KenneysDigToShowerbath 20.27@ShowerbathArea 
    equate 10.9@KenneysDigToShowerbath 11.0@WetWayOxbows
    equate 6.8@OldGrottoToWaterChamber 6.8@InletOffOldGrottoToWaterChamber
    equate 11.44@WetWayOxbows 6.11@OldGrottoToWaterChamber 
    equate 6.11@OldGrottoToWaterChamber 8.0@WaterRift
    equate 6.11@OldGrottoToWaterChamber 13.0@WaterChamber
    equate 13.27@WaterChamber 11.33@WetWayOxbows
    equate 8.4@WaterRift 9.0@Old40Route
    equate 8.12@WaterRift 9.11@Old40Route
    equate 8.12@WaterRift 17.0@Old40To20
    equate 8.16@WaterRift 17.6@Old40To20
    equate 11.24@WetWayOxbows 12.0@ButcombeOxbows 
    equate 11.33@WetWayOxbows 14.0@WetWayKeyhole 
    equate 11.11@WetWayOxbows 14.6@WetWayKeyhole 
    equate 11.37@WetWayOxbows 18.0@CisternDig 
    equate 12.27@ButcombeOxbows 15.0@OxbowJunction
    equate 12.27@ButcombeOxbows 16.0@LowerOxbow
    equate 12.30@ButcombeOxbows 11.18@WetWayOxbows
    equate 13.20@WaterChamber 16.16@LowerOxbow
    equate 9.11@Old40Route 25.0@RollingThunder
    equate 17.24@Old40To20 21.0@20ftToBarnesLoop
    equate 21.25@20ftToBarnesLoop 22.0@DblPotsDownstream
    equate 22.10@DblPotsDownstream 23.0@BarnesLoopToTratmans
    equate 22.20@DblPotsDownstream 23.12@BarnesLoopToTratmans #Barnes Loop rejoins the streamway
    equate 23.33@BarnesLoopToTratmans 24.0@TratmansToSump1
    
  endcentreline
endsurvey

