encoding  utf-8
#Swildons Hole, Priddy, Mendip, Somerset, UK
#Master Survey Project. Lead by Paul 'Footleg' Fretwell, Jun. 2013 - Jan. 2019

survey SwildonsHole
  #import cave centreline
  input Swildons_Centreline.th
  input Tratmans/Tratmans.th

  centreline
    #Tratmans station 1 is the top of the rock at the top of the climb into Tratman's Temple
    equate 1@Tratmans 23.33@BarnesLoopToTratmans.Swildons
  endcentreline

  #import maps for plan drawings
  input Entrance/Swildons_MAP_EntranceSeries.th
  input Streamway/Swildons_MAP_Streamway1.th

  #import maps for elevation drawings
  input Entrance/Swildons_MAP-elev_EntranceSeries.th
  input Streamway/Swildons_MAP-elev_Streamway.th
  input Entrance/Swildons_MAP-ext_EntranceSeries.th
  
  #Master Map
  map MasterPlan -title "Swildons Hole"
    EntranceSeriesPlan
    Streamway1Plan
    TratmansMP@Tratmans
  endmap

  #The resurvey's survey legs. A map only draws the legs of the surveys
  #listed in it, not of those its scraps attach to, so the working
  #sheets add this to the drawn plan. Add each new trip's survey here.
  map ResurveyCentreline -projection plan -title "Resurvey centreline"
    20ftToBarnesLoop@Swildons
    BarnesLoopToTratmans@Swildons
    ButcombeOxbows@Swildons
    CisternDig@Swildons
    DblPotsDownstream@Swildons
    InletOffOldGrottoToWaterChamber@Swildons
    KenneysDigToShowerbath@Swildons
    LongDryWay@Swildons
    LowerOxbow@Swildons
    NewGrottoes@Swildons
    Old40Route@Swildons
    Old40To20@Swildons
    OldGrottoToWaterChamber@Swildons
    OxbowJunction@Swildons
    RollingThunder@Swildons
    ShortDryWay@Swildons
    ShowerbathArea@Swildons
    TratmansToSump1@Swildons
    WaterChamber@Swildons
    WaterRift@Swildons
    WetWayKeyhole@Swildons
    WetWayOxbows@Swildons
    ZigZags@Swildons
    Tratmans
  endmap

  map PlanWithCentreline -title "Swildons Hole"
    MasterPlan
    ResurveyCentreline
  endmap

  #Extended elevation of everything drawn, from the entrance to Sump 1
  map WholeCaveExtended -projection extended -title "Swildons Hole - extended elevation"
    EntranceSeriesExtended
    StreamwayElevation
  endmap

  #W. I. Stanton's survey as centreline, for planning the resurvey beyond Sump 1
  map StantonCentreline -projection plan -title "W. I. Stanton's survey"
    wstanton@Swildons
  endmap

  map PlanWithStanton -title "Swildons Hole - resurvey and W. I. Stanton's survey"
    MasterPlan
    ResurveyCentreline
    StantonCentreline
  endmap
endsurvey

